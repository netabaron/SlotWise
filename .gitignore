# ==========================================================================
#  סודות וסשנים — לעולם לא לוועד. SECRETS AND SESSIONS — NEVER COMMIT.
# ==========================================================================
# פרופיל הדפדפן של Playwright. מכיל את עוגיות ההתחברות החיות של שער ה-Citrix
# של המכללה (NSC_AAAC וחברותיה), היסטוריה, וקאש. מי שמשיג את התיקייה הזאת
# יכול להתחבר לידיעון בתור הסטודנט/ית. 29MB של דבר שאסור שיצא מהמחשב הזה.
# The Playwright browser profile holds LIVE Citrix session cookies. Anyone with
# this directory can log into the yedion as the student. Never publish it.
data/.browser_profile/
**/.browser_profile/
*.browser_profile/

# עוגיות / טוקנים / אישורים בכל צורה שהיא
cookies.txt
*cookies*
*.cookie
*.cookies
storage_state.json
auth.json
.netrc
_netrc
*.pem
*.key
*.pfx
*.p12
*.keystore
.env
.env.*
!.env.example
# מכוון: תבניות *מדויקות* ולא גלובים רחבים כמו *secret* / *token* / *credential*.
# גלוב רחב היה מתעלם בשקט גם מקבצי מקור לגיטימיים (tokenizer.py, credentials.py),
# והתקלה הזאת מתגלה רק חודשים אחר כך כשקובץ פשוט "נעלם" מהריפו.
# Deliberately precise: broad globs would silently ignore real source files.
secrets.json
.secrets
*.secret
*.secrets
credentials.json
.credentials
*.token
.htpasswd

# ==========================================================================
#  נתונים אישיים ומסמכי המכללה — לא לפרסום
# ==========================================================================
# הפרופיל האישי: שנה, סמסטר, ורשימת הקורסים של הסטודנט/ית.
# אין בו סיסמאות, אבל הוא מידע אישי. יש להעתיק את data/profile.example.json
# ל-data/profile.json ולערוך. | Personal: copy the example and edit it.
data/profile.json

# פרק השנתון של המחלקה — מסמך של המכללה, לא שלנו לפרסם.
# ממנו נגזר data/curriculum.json (שכן נכנס לגיט, כי הוא התוצר שלנו).
# The college's own catalog document - not ours to publish.
rec.pdf
*.pdf
!docs/*.pdf

# ==========================================================================
#  נתונים שנשלפו מהידיעון — לא לפרסום
# ==========================================================================
# דפי HTML גולמיים מתוך סשן מחובר. הם תוכן של המכללה, ועשויים להכיל פרטים
# מזהים מתוך הכותרת של המשתמש/ת המחובר/ת. נשמרים מקומית לצורך דיבוג הפרסר
# (ראו reparse.py) — לא נכנסים לגיט.
# Raw pages fetched from inside an authenticated session.
data/raw/

# מסד הנתונים הנגזר. כולו ניתן לשחזור: refresh.py (עם התחברות) או
# reparse.py (מהדמפים המקומיים). תוכן של המכללה — לא מפרסמים.
data/db/

# ==========================================================================
#  ‏data/ — הכול חסום, ורק מה שהוא תוצר שלנו נפתח במפורש
# ==========================================================================
# ‏עד 2026-09-16 הרשימה כאן הייתה שלילית: כל מה שאסור היה מנוי בשמו, וכל
# קובץ חדש תחת data/ נכנס לגיט בשקט. מאז שהבנייה היא עבודת cron שכותבת
# ל-data/ אוטומטית, זה הכיוון הלא נכון — ריצה שתכתוב דמפ או מסד לתוך
# data/ הייתה נדחפת ל-main בלי שאיש יבחין.
#
# ‏לכן: חוסמים את data/ כולו, ופותחים **רק** את מה שהוא תוצר מכוון שלנו.
# ‏git אינו נכנס לתיקייה חסומה, ולכן כל רמה בדרך חייבת להיפתח בנפרד —
# זו הסיבה לשורות ה-‎!data/‎ וה-‎!data/catalog/‎ שנראות מיותרות.
data/*
!data/catalog/
data/catalog/*

# ‏פלט הצינור. שני הקבצים היחידים תחת data/ שהבנייה האוטומטית כותבת,
# והיחידים שהיא מורשית לדחוף.
!data/catalog/catalog.jsonl
!data/catalog/catalog.meta.json

# ‏תוכניות הלימודים והתוכניות עצמן — תוצר שלנו, נבנה מהשנתון ונכנס לגיט
# מאז שהכלי תמך ביותר ממחלקה אחת. **הן אינן פלט של הצינור**, ולכן הן
# מנויות כאן בנפרד ולא תחת data/catalog/.
#
# ‏בלעדיהן שכפול נקי עולה בלי תוכנית לימודים בכלל: ‏/api/semester/<sem>/courses
# מחזיר רשימה ריקה ו-/api/program/electives מחזיר available:false. אומת
# ‏2026-09-16.
!data/curriculum.json
!data/curricula.json
!data/curricula/
!data/curricula/*.json
!data/programs.json

# ‏הפרופיל לדוגמה — מה שמעתיקים ל-data/profile.json. ‏profile.json עצמו
# נשאר חסום (ראו למעלה).
!data/profile.example.json

